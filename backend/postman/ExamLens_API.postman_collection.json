{
  "info": {
    "name": "ExamLens Backend API",
    "description": "Complete API collection for ExamLens — University Examination & Automated Proctoring Portal",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminToken", "value": "" },
    { "key": "studentToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "studentId", "value": "" },
    { "key": "examId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@examlens.edu\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/admin/login" }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "pm.collectionVariables.set('adminToken', json.accessToken);",
                "pm.collectionVariables.set('refreshToken', json.refreshToken);"
              ]
            }
          }]
        },
        {
          "name": "Student Activate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rollNumber\": \"CS2026010\",\n  \"officialEmail\": \"aarav.sharma@examlens.edu\",\n  \"passcode\": \"student123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/student/activate" }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "pm.collectionVariables.set('studentToken', json.accessToken);",
                "pm.collectionVariables.set('studentId', json.userId);"
              ]
            }
          }]
        },
        {
          "name": "Student Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rollNumber\": \"CS2026010\",\n  \"passcode\": \"student123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/student/login" }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "pm.collectionVariables.set('studentToken', json.accessToken);"
              ]
            }
          }]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/refresh" }
          }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "Create Student",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rollNumber\": \"CS2026010\",\n  \"fullName\": \"Aarav Sharma\",\n  \"officialEmail\": \"aarav.sharma@examlens.edu\",\n  \"department\": \"Computer Science\",\n  \"semester\": 5,\n  \"gpa\": 8.8\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/students" }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "pm.collectionVariables.set('studentId', json.id);"
              ]
            }
          }]
        },
        {
          "name": "List Students",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/students?page=0&size=20" }
          }
        },
        {
          "name": "Get Student by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/students/{{studentId}}" }
          }
        },
        {
          "name": "Update Student",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Aarav K. Sharma\",\n  \"semester\": 6,\n  \"gpa\": 9.1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/students/{{studentId}}" }
          }
        },
        {
          "name": "Delete Student",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/students/{{studentId}}" }
          }
        },
        {
          "name": "Import CSV",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/students/import" }
          }
        },
        {
          "name": "Purge All Students",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "X-Confirm-Purge", "value": "true" }
            ],
            "url": { "raw": "{{baseUrl}}/api/students/purge" }
          }
        }
      ]
    },
    {
      "name": "Exams",
      "item": [
        {
          "name": "Create Exam",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Data Structures & Algorithms\",\n  \"subjectCode\": \"CS301\",\n  \"faculty\": \"Dr. Pankaj Kumar\",\n  \"scheduledStart\": \"2026-08-15T09:00:00Z\",\n  \"scheduledEnd\": \"2026-08-15T12:00:00Z\",\n  \"durationMinutes\": 180,\n  \"totalMarks\": 100,\n  \"passingMarks\": 40,\n  \"totalQuestions\": 50,\n  \"enrolledStudents\": 45,\n  \"description\": \"End-semester DSA examination\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/exams" }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "pm.collectionVariables.set('examId', json.id);"
              ]
            }
          }]
        },
        {
          "name": "List Exams",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/exams" }
          }
        },
        {
          "name": "Get Exam by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/exams/{{examId}}" }
          }
        },
        {
          "name": "Update Exam",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/exams/{{examId}}" }
          }
        },
        {
          "name": "Delete Exam",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/exams/{{examId}}" }
          }
        }
      ]
    },
    {
      "name": "Results",
      "item": [
        {
          "name": "Submit Result",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"examId\": \"{{examId}}\",\n  \"studentId\": \"{{studentId}}\",\n  \"score\": 78.5,\n  \"maxScore\": 100,\n  \"aiConfidenceScore\": 96.8\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/results" }
          }
        },
        {
          "name": "List Results",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/results" }
          }
        },
        {
          "name": "Get Student Results (self-access)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/results/student/{{studentId}}" }
          }
        }
      ]
    },
    {
      "name": "Alerts",
      "item": [
        {
          "name": "Log Alert",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"examId\": \"{{examId}}\",\n  \"studentId\": \"{{studentId}}\",\n  \"studentName\": \"Aarav Sharma\",\n  \"examName\": \"DSA\",\n  \"type\": \"FACE_LOST\",\n  \"confidenceScore\": 0.45,\n  \"severity\": \"warning\",\n  \"notes\": \"Face not detected for 8 seconds\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/alerts" }
          }
        },
        {
          "name": "List Alerts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/alerts" }
          }
        },
        {
          "name": "Resolve Alert",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RESOLVED\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/alerts/{{alertId}}/status" }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Metrics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/dashboard/metrics" }
          }
        }
      ]
    }
  ]
}
