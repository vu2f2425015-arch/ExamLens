# Firebase Configuration Keys
# Replace the placeholders below with your actual Firebase project settings from Firebase Console:
# https://console.firebase.google.com/ -> Project Settings -> General -> Your apps -> Web app

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Backend URL (REST API Spring Boot Service)
VITE_BACKEND_URL=http://localhost:8080/api

# Security & Demo Settings
# WARNING: VITE_ENABLE_DEMO_BYPASS must be 'false' or unset in production deployments!
VITE_ENABLE_DEMO_BYPASS=true

# Local Mock Admin Access
VITE_ADMIN_ID=admin
# Default hash is SHA-256 for 'admin123'
VITE_ADMIN_PASSWORD_HASH=240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9
